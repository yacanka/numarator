# Copy this file outside the repository; fill it locally, never commit secrets.
# Use a cryptographically random SECRET_KEY (at least 50 characters).
SECRET_KEY=
# Absolute local directory outside the repository. No environment expansion.
# Windows example: C:/Users/your-user/AppData/Local/Numarator/data
NUMARATOR_DATA_DIR=
TIME_ZONE=Europe/Istanbul
APP_LOG_LEVEL=INFO
